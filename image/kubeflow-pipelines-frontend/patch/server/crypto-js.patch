Subject: Remove crypto-js and use the native Node.js crypto implementation

The frontend server uses crypto-js only to derive a viewer resource hash. Replace it with the native Node.js crypto implementation so the affected dependency is not shipped.

Origin: DHI-internal (dependency removal)
Advisory: https://github.com/brix/crypto-js/security/advisories/GHSA-xwcq-pm8m-c4vf
Base-Tree: git https://github.com/kubeflow/pipelines.git a0733cb51b0484a6050cafee989ffe3312f808ad path=frontend/server
Verify: cmd `dhi def build image/kubeflow-pipelines-frontend/debian-13/2.yaml` expect "tsc --project ."
Forwarded: no (DHI-specific dependency hardening)
Drop-When: never: upstream still depends on crypto-js for the frontend viewer resource hash

--- /k8s-helper.ts
+++ /k8s-helper.ts
@@ -19,7 +19,7 @@ import {
   V1Pod,
   V1ConfigMap,
 } from '@kubernetes/client-node';
-import crypto from 'crypto-js';
+import * as crypto from 'crypto';
 import * as fs from 'fs';
 import { PartialArgoWorkflow } from './workflow-helper.js';
 import { findFileOnPodVolume, isAllowedResourceName } from './utils.js';
@@ -80,7 +80,8 @@ const k8sV1CustomObjectClient = kc.makeApiClient(CustomObjectsApi);

 function getNameOfViewerResource(logdir: string): string {
   // TODO: find some hash function with shorter resulting message.
-  return 'viewer-' + crypto.SHA1(logdir);
+  const hash = crypto.createHmac('sha1', logdir)
+  return 'viewer-' + hash.digest('hex');
 }

 function unwrapCustomObject<T>(resource: T | { body?: T } | undefined | null): T | undefined {

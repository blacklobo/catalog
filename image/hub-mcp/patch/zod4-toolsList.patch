Subject: zod 4.x compatibility for toolsList script

Origin: DHI-internal (hub-mcp image npm bump overlay)
CVE: CVE-2023-54404
Description: zod 4 changes ZodTypeAny; cast schemas for zod-to-json-schema until upstream hub-mcp adopts zod 4 types.
Base-Tree: git https://github.com/docker/hub-mcp.git 68f4c79223f3ac2a5b6732de58ce7ba22aa8f1a8
Adaptation: Type-only casts in src/scripts/toolsList.ts so the TypeScript build succeeds after npm-bumps.json pins zod 4.6.6.
Forwarded: not-needed (DHI image overlay until upstream migrates to zod 4)
Drop-When: upstream >= 0.20.0 (once docker/hub-mcp pins zod 4.6.6+ and toolsList.ts builds without this overlay)
Verify: cmd `bash -c 'u=$(mktemp -d) && git clone -q --depth 1 https://github.com/docker/hub-mcp.git "$u" && git -C "$u" checkout -q 68f4c79223f3ac2a5b6732de58ce7ba22aa8f1a8 && patch -p1 --dry-run -d "$u" < image/hub-mcp/patch/zod4-toolsList.patch'` expect "checking file src/scripts/toolsList.ts"

---
diff --git a/src/scripts/toolsList.ts b/src/scripts/toolsList.ts
--- a/src/scripts/toolsList.ts
+++ b/src/scripts/toolsList.ts
@@ -21,7 +21,6 @@
 import fs from 'fs';
 import path from 'path';
 import { program } from 'commander';
-import { ZodTypeAny } from 'zod';
 
 const EMPTY_OBJECT_JSON_SCHEMA = {
     type: 'object' as const,
@@ -73,7 +72,7 @@
                     name,
                     description: tool.title, // Use title instead of description to have less noise in the tools list
                     inputSchema: tool.inputSchema
-                        ? (zodToJsonSchema(tool.inputSchema as ZodTypeAny, {
+                        ? (zodToJsonSchema(tool.inputSchema as any, {
                               strictUnions: true,
                           }) as Tool['inputSchema'])
                         : EMPTY_OBJECT_JSON_SCHEMA,
@@ -81,7 +80,7 @@
                 };
 
                 if (tool.outputSchema) {
-                    toolDefinition.outputSchema = zodToJsonSchema(tool.outputSchema as ZodTypeAny, {
+                    toolDefinition.outputSchema = zodToJsonSchema(tool.outputSchema as any, {
                         strictUnions: true,
                     }) as Tool['outputSchema'];
                 }

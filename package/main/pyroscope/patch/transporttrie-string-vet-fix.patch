Subject: Format transport trie numeric values as decimal integers
Description: Use the matching decimal format verb for unsigned trie values during string rendering.
Origin: backport, https://github.com/grafana/pyroscope/commit/4e5b714d3d3db711efbf111c1b83d1492850e0d6
Base-Tree: git https://github.com/grafana/pyroscope.git c7f6f34e8b697db6ae09771e983638cfcdb67c1a
Adaptation: Extracted the format-verb correction and rebased it onto maintained v1 source releases.
Verify: test tests/transporttrie_patch_test.go::TestTransporttrieStringPatchPresent

--- a/pkg/og/structs/transporttrie/string.go
+++ b/pkg/og/structs/transporttrie/string.go
@@ -22,7 +22,7 @@ func (t *Trie) String() string {
 		for i := 0; i < level; i++ {
 			prefix += "-"
 		}
-		str += fmt.Sprintf("%s %q %q %q\n", prefix, parentName, node.name, node.value)
+		str += fmt.Sprintf("%s %q %q %d\n", prefix, parentName, node.name, node.value)
 		names := [][]byte{}
 		for _, v := range node.children {
 			names = append(names, v.name)

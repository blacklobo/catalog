Subject: Select UTF-8 validation for Prometheus relabel rules
Description: Pass the required validation scheme when checking relabel configurations with Prometheus version 0.311.3.
Origin: backport, https://github.com/grafana/pyroscope/commit/b4cce6ff1e02743af7c04c0823be93842ee94b9e
Base-Tree: git https://github.com/grafana/pyroscope.git c7f6f34e8b697db6ae09771e983638cfcdb67c1a
Adaptation: Extracted and rebased the relabel validation call required by the older supported source releases.
Verify: cmd `go test ./pkg/validation` expect "ok"

--- a/pkg/validation/relabeling.go
+++ b/pkg/validation/relabeling.go
@@ -85,7 +85,7 @@ func (p *RelabelRules) Set(s string) error {
 	}

 	for idx, rule := range v {
-		if err := rule.Validate(); err != nil {
+		if err := rule.Validate(model.UTF8Validation); err != nil {
 			return fmt.Errorf("rule at pos %d is not valid: %w", idx, err)
 		}
 	}

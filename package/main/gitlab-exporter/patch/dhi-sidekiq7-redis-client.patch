@@ -183,8 +187,16 @@
 
       def with_sidekiq
         SIDEKIQ_REDIS_LOCK.synchronize {
+          options = redis_options.merge(size: POOL_SIZE, pool_timeout: POOL_TIMEOUT)
           Sidekiq.configure_client do |config|
-            config.redis = self.class.connection_pool[redis_options]
+            # Sidekiq 7: config.redis= must be a Hash; Sidekiq builds the pool.
+            config.redis = options
+            # redis= merges into @redis_config and does not drop an existing
+            # pool, so clear it when the options change (or on first use).
+            if self.class.last_redis_options != options
+              config.instance_variable_set(:@redis, nil)
+              self.class.last_redis_options = options
+            end
           end
 
           return unless connected?

Subject: Omit the bundled Node.js statement from Kibana's NOTICE.txt

Origin: DHI-internal (Node.js is installed from the nodejs package, not bundled)
Base-Tree: git https://github.com/elastic/kibana.git a2890159e2486503b9e3a0c6f422b153a746651a
Verify: cmd `grep -c "This product bundles Node.js" /usr/share/kibana/NOTICE.txt` expect "0"
Forwarded: not-needed (upstream ships Node.js inside the distributable, so its NOTICE.txt is correct there)
Drop-When: never: DHI always supplies Node.js through the nodejs package instead of the upstream bundled copy

Upstream appends the license text of the Node.js binary it bundles to NOTICE.txt. The DHI package ships no Node.js binary and depends on the nodejs package, which carries its own SBOM entry, so this removes the Node.js section instead of reading a LICENSE file that is no longer staged. The file is identical in Kibana 9.4.x and 9.5.x.

--- a/src/dev/notice/generate_build_notice_text.js
+++ b/src/dev/notice/generate_build_notice_text.js
@@ -8,25 +8,18 @@
  */
 
 import { generatePackageNoticeText } from './generate_package_notice_text';
-import { generateNodeNoticeText } from './generate_node_notice_text';
 
 /**
- *  When given a list of packages and the directory to the
- *  node distribution that will be shipping with Kibana,
- *  generates the text for NOTICE.txt
+ *  When given a list of packages, generates the text for NOTICE.txt
  *
  *  @param  {Object} [options={}]
  *  @property {Array<Package>} options.packages List of packages to check, see
  *                                              getInstalledPackages() in ../packages
- *  @property {string} options.nodeDir The directory containing the version of node.js
- *                                     that will ship with Kibana
  */
 export async function generateBuildNoticeText(options = {}) {
-  const { packages, nodeDir, nodeVersion, noticeFromSource } = options;
+  const { packages, noticeFromSource } = options;
 
   const packageNotices = await Promise.all(packages.map(generatePackageNoticeText));
 
-  return [noticeFromSource, ...packageNotices, generateNodeNoticeText(nodeDir, nodeVersion)].join(
-    '\n---\n'
-  );
+  return [noticeFromSource, ...packageNotices].join('\n---\n');
 }

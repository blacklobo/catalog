Origin: DHI-internal (Kubernetes client compatibility)
Description: Initialize EffectiveVersion for k8s.io/apiserver v0.35, alias OpenAPI
 definitions under OpenAPIModelName / ToRESTFriendlyName keys, and normalise
 GetDefinitionName so the served OpenAPI spec uses friendly names with GVK.
 Also verified with local package build + helm TestInstall against local-mirror image.
Base-Tree: git https://github.com/kyverno/reports-server.git 7f1511eeb6b5f4a83bab914214b5dcd22d8d3e14
Verify: test alpine-3.24/0.yaml
Drop-When: upstream >= 0.1.8
Forwarded: not-needed (upstream still pins apiserver v0.29)
Upstream API: https://github.com/kubernetes/kubernetes/blob/v0.35.0/staging/src/k8s.io/apiserver/pkg/server/config.go
Upstream source: https://github.com/kyverno/reports-server/blob/v0.1.7/pkg/app/opts/options.go

--- a/pkg/app/opts/options.go
+++ b/pkg/app/opts/options.go
@@ -12,7 +12,11 @@
 	generatedopenapi "github.com/kyverno/reports-server/pkg/api/generated/openapi"
 	"github.com/kyverno/reports-server/pkg/storage/etcd"
 	openapinamer "k8s.io/apiserver/pkg/endpoints/openapi"
+	utilcompatibility "k8s.io/apiserver/pkg/util/compatibility"
 	genericapiserver "k8s.io/apiserver/pkg/server"
+	openapicommon "k8s.io/kube-openapi/pkg/common"
+	openaputil "k8s.io/kube-openapi/pkg/util"
+	"k8s.io/kube-openapi/pkg/validation/spec"
 	genericoptions "k8s.io/apiserver/pkg/server/options"
 	"k8s.io/client-go/pkg/version"
 	"k8s.io/client-go/rest"
@@ -147,14 +151,36 @@
 	}
 
 	versionGet := version.Get()
-	serverConfig.Version = &versionGet
+	versionString := strings.Split(versionGet.String(), "-")[0]
+	serverConfig.EffectiveVersion = utilcompatibility.DefaultBuildEffectiveVersion()
 	// enable OpenAPI schemas
-	serverConfig.OpenAPIConfig = genericapiserver.DefaultOpenAPIConfig(generatedopenapi.GetOpenAPIDefinitions, openapinamer.NewDefinitionNamer(api.Scheme))
-	serverConfig.OpenAPIV3Config = genericapiserver.DefaultOpenAPIV3Config(generatedopenapi.GetOpenAPIDefinitions, openapinamer.NewDefinitionNamer(api.Scheme))
+	// Generated defs still key models as k8s.io/...; v0.35 routes look up
+	// OpenAPIModelName keys (io.k8s...). Alias both forms, then normalise
+	// GetDefinitionName so the served spec uses friendly names + GVK tags.
+	getOpenAPIDefs := func(ref openapicommon.ReferenceCallback) map[string]openapicommon.OpenAPIDefinition {
+		defs := generatedopenapi.GetOpenAPIDefinitions(ref)
+		out := make(map[string]openapicommon.OpenAPIDefinition, len(defs)*2)
+		for name, def := range defs {
+			out[name] = def
+			out[openaputil.ToRESTFriendlyName(name)] = def
+		}
+		return out
+	}
+	namer := openapinamer.NewDefinitionNamer(api.Scheme)
+	getDefName := func(name string) (string, spec.Extensions) {
+		if strings.Contains(name, "/") {
+			name = openaputil.ToRESTFriendlyName(name)
+		}
+		return namer.GetDefinitionName(name)
+	}
+	serverConfig.OpenAPIConfig = genericapiserver.DefaultOpenAPIConfig(getOpenAPIDefs, namer)
+	serverConfig.OpenAPIV3Config = genericapiserver.DefaultOpenAPIV3Config(getOpenAPIDefs, namer)
+	serverConfig.OpenAPIConfig.GetDefinitionName = getDefName
+	serverConfig.OpenAPIV3Config.GetDefinitionName = getDefName
 	serverConfig.OpenAPIConfig.Info.Title = "reports-server"
 	serverConfig.OpenAPIV3Config.Info.Title = "reports-server"
-	serverConfig.OpenAPIConfig.Info.Version = strings.Split(serverConfig.Version.String(), "-")[0] // TODO(directxman12): remove this once autosetting this doesn't require security definitions
-	serverConfig.OpenAPIV3Config.Info.Version = strings.Split(serverConfig.Version.String(), "-")[0]
+	serverConfig.OpenAPIConfig.Info.Version = versionString
+	serverConfig.OpenAPIV3Config.Info.Version = versionString
 
 	return serverConfig, nil
 }

Subject: Keep the GenQL source generator out of the runtime dependency set
Origin: DHI packaging adjustment for the hub-mcp 0.19.0 release
Upstream source: https://github.com/docker/hub-mcp/tree/dockerhub-mcp/v0.19.0
The genql.scout script uses @genql/cli to generate source, while the runtime
loads only the generated client. Classifying the CLI as a development
dependency keeps its GraphQL and glob build toolchain out of the package.

diff --git a/package.json b/package.json
index 9a961db..7bc521f 100644
--- a/package.json
+++ b/package.json
@@ -28,6 +28,5 @@
     "dependencies": {
         "@apidevtools/swagger-parser": "^10.1.0",
-        "@genql/cli": "^6.3.3",
         "@modelcontextprotocol/sdk": "1.24.0",
         "@modelcontextprotocol/specification": "github:modelcontextprotocol/specification",
         "express": "^5.1.0",
@@ -37,6 +36,7 @@
         "zod": "^3.25.67"
     },
     "devDependencies": {
+        "@genql/cli": "^6.3.3",
         "@types/express": "^5.0.3",
         "@types/lodash": "^4.17.19",
         "@types/node": "^20.10.0",
